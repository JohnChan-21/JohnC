# ====================================================================
# 后端环境变量模板（systemd EnvironmentFile 用）
# 复制到 /etc/film-comment/env 后填真实值，并 chmod 600（含密钥）
# 所有变量均为 prod 启动必需，缺失将启动失败（刻意 fail-fast）
# ====================================================================

# --- MySQL ---
# 必须是最小权限的非 root 应用账号（john123456），勿用 root
DB_USERNAME=john123456
DB_PASSWORD=<DB密码>
# 生产连接串：启用 SSL、不允许 allowMultiQueries / allowPublicKeyRetrieval
# 注意：必须保留双引号（含 & 等特殊字符；install.sh / init-db.sh 会 source 本文件）
DB_URL="jdbc:mysql://127.0.0.1:3306/film_comment_system?useUnicode=true&characterEncoding=utf-8&useSSL=true&serverTimezone=GMT%2b8"

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 必须与 redis.conf 的 requirepass 一致
REDIS_PASSWORD=<Redis密码>

# --- 业务 ---
# 上传图片返回 URL 的前缀：填真实站点域名（同源部署 = 前端域名），结尾不带斜杠
# 内网/本地 HTTP 测试部署（install.sh DEPLOY_MODE=test）：此处会被自动写成 http://内网IP
FILE_BASE_URL=https://your-domain.com

# --- CORS（仅前后端分域名部署时填写）---
# 同源部署（Nginx 同域名反代，推荐）：保持注释状态即可，同源请求不走 CORS
# CORS_ALLOWED_ORIGINS=https://frontend.your-domain.com